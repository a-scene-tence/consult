# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. .env 는 절대 커밋하지 않는다.

# Claude Messages API 키 (CLAUDE.md §1)
ANTHROPIC_API_KEY=

# 기본 LLM 모델 (CLAUDE.md §1)
LLM_MODEL=claude-opus-4-8

# PostgreSQL 접속 (SPEC §3.2)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/consult

# ChromaDB (RAG) 저장 경로 (CLAUDE.md §1)
CHROMA_PERSIST_DIR=./.chroma
# RAG 지속 학습 파라미터 (CLAUDE.md §2.4) — 코호트 조회 컬렉션·top_k·최소 유사도 임계값
CHROMA_COLLECTION=past_consulting_cases
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.75

# API 서버 (uvicorn main:app) — Phase 5
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Phase 6: 프로덕션 인프라 ---
# JWT 인증 (web/auth.py) — 반드시 강력한 시크릿으로 교체
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=120

# 비동기 작업 백엔드: inline(기본, BackgroundTasks) | celery(Redis 큐)
TASK_BACKEND=inline
# Celery broker/result backend (celery -A web.celery_app worker)
REDIS_URL=redis://localhost:6379/0
# 테스트 시 인프로세스 동기 실행
CELERY_TASK_ALWAYS_EAGER=

# RAG 활성화(ChromaDB 물림) — 1이면 ChromaCaseStore 사용
RAG_ENABLED=
