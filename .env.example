# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. .env 는 절대 커밋하지 않는다.

# Claude Messages API 키 (CLAUDE.md §1)
ANTHROPIC_API_KEY=

# 기본 LLM 모델 (CLAUDE.md §1)
LLM_MODEL=claude-opus-4-8

# PostgreSQL 접속 (SPEC §3.2)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/consult

# ChromaDB (RAG) 저장 경로 (CLAUDE.md §1)
CHROMA_PERSIST_DIR=./.chroma
# RAG 지속 학습 파라미터 (CLAUDE.md §2.4) — 코호트 조회 컬렉션·top_k·최소 유사도 임계값
CHROMA_COLLECTION=past_consulting_cases
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.75

# API 서버 (uvicorn main:app) — Phase 5
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Phase 6: 프로덕션 인프라 ---
# JWT 인증 (web/auth.py) — 반드시 강력한 시크릿으로 교체
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=120

# 비동기 작업 백엔드: inline(기본, BackgroundTasks) | celery(Redis 큐)
TASK_BACKEND=inline
# Celery broker/result backend (celery -A web.celery_app worker)
REDIS_URL=redis://localhost:6379/0
# 테스트 시 인프로세스 동기 실행
CELERY_TASK_ALWAYS_EAGER=

# RAG 활성화(ChromaDB 물림) — 1이면 ChromaCaseStore 사용
RAG_ENABLED=

# --- Phase 7: 복원력·배포 ---
# 자가치유 재시도 최대 횟수(numeric_guard/스키마 위반 시 교정 재작성)
LLM_MAX_ATTEMPTS=3
# 데모 시드 계정 비밀번호(운영은 강력한 값으로, 시드 자체를 비활성 권장)
ADMIN_PASSWORD=admin-secret
OWNER_PASSWORD=owner-secret
# docker-compose 기동 훅 제어
RUN_MIGRATIONS=1
SEED_USERS=1

# --- Phase 8: 보안·운영 모니터링 ---
# CORS 허용 오리진(콤마 구분). '*'이면 모든 오리진(단, credentials 비활성)
ALLOWED_ORIGINS=*
# Rate Limit (slowapi). 전역 기본 + LLM 엔드포인트(start/feedback) 엄격 제한
RATE_LIMIT_ENABLED=1
DEFAULT_RATE_LIMIT=200/minute
STRICT_RATE_LIMIT=5/minute
# Celery 태스크 타임아웃(초)·재시도 — Anthropic 429/50x 지수 백오프
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_MAX=600
# Flower(Celery 모니터링) 포트
FLOWER_PORT=5555
