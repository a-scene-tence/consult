{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consult.local/schemas/agent2_bs_analysis.json",
  "title": "agent2_bs_analysis",
  "description": "Agent 2(BS 분석가) 출력 계약 v0.3. SPEC §2.2, §2.6. 서술·해석만 담으며 새 수치를 생성하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "summary", "findings", "cash_reserve_alerts", "adherence_review", "out_of_scope"],
  "properties": {
    "agent": { "type": "string", "const": "bs_analyst" },
    "summary": { "type": "string", "description": "BS 관점 종합 한두 문장(프로필 눈높이)." },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "text", "source_ref", "severity"],
        "properties": {
          "topic": { "type": "string", "description": "예: cash_conversion, leverage, owner_draws, liquidity" },
          "text": { "type": "string" },
          "source_ref": {
            "type": "array",
            "items": { "type": "string" },
            "description": "근거 코드(예: CR, DR, dscr, cash_conversion_cycle_days, owner_draws)."
          },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "cash_reserve_alerts": {
      "type": "array",
      "description": "세무 캘린더(upcoming_tax_events) 1~2개월 내 도래 시 cash_runway·현금 인용 현금 유보 강력 권고(흑자도산 방지). 없으면 빈 배열.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_ref", "severity"],
        "properties": {
          "text": { "type": "string" },
          "source_ref": { "type": "array", "items": { "type": "string" } },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "adherence_review": {
      "type": "array",
      "description": "직전 회차 권고 중 BS 관련 항목의 이행 성과(metric_progress 인용). baseline 이면 빈 배열.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rec_code", "text", "source_ref"],
        "properties": {
          "rec_code": { "type": "string" },
          "text": { "type": "string" },
          "source_ref": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "역할 경계 밖 주제 표기(예: 수익성/품목 마진/BEP)."
    }
  }
}
